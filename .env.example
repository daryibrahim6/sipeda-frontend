# Supabase — dapatkan dari: https://app.supabase.com/project/[project-id]/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service Role Key — JANGAN commit ke git, JANGAN expose ke browser
# Hanya untuk server-side (API routes, server actions)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Fonnte — WhatsApp gateway (https://fonnte.com)
FONNTE_API_KEY=your-fonnte-api-key

# URL untuk metadata OpenGraph
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Search engine verification — isi dari Google Search Console & Bing Webmaster
# NEXT_PUBLIC_GOOGLE_VERIFICATION=xxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_BING_VERIFICATION=xxxxxxxxxxxxxxxxx

# Google Analytics — Measurement ID (format: G-XXXXXXXXXX)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
