# Supabase — dapatkan dari: https://app.supabase.com/project/[project-id]/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service Role Key — JANGAN commit ke git, JANGAN expose ke browser
# Hanya untuk server-side (API routes, server actions)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Fonnte — WhatsApp gateway (https://fonnte.com)
FONNTE_API_KEY=your-fonnte-api-key

# OpenRouter — Chatbot AI gateway (https://openrouter.ai)
OPENROUTER_API_KEY=your-openrouter-api-key

# URL untuk metadata OpenGraph
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Search engine verification — isi dari Google Search Console & Bing Webmaster
# NEXT_PUBLIC_GOOGLE_VERIFICATION=xxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_BING_VERIFICATION=xxxxxxxxxxxxxxxxx

# Google Analytics — Measurement ID (format: G-XXXXXXXXXX)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Upstash Redis — OPSIONAL, untuk distributed rate limiting (https://upstash.com)
# Default: pakai in-memory Map (cukup untuk traffic rendah-menengah).
# Set env ini HANYA jika: (a) traffic tinggi, (b) perlu proteksi distributed
# di Vercel multi-region (in-memory = per-lambda instance, ada limitasi).
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token
